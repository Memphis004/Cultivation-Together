<?xml version="1.0" encoding="utf-8"?>
<module name="worldevent">
    <bean name="EventRow">
        <var name="id" type="string"/>
        <var name="description" type="string"/>
        <var name="requiresDecision" type="bool"/>
        <var name="weight" type="float"/>
    </bean>
    <table name="TbEvent" value="EventRow" input="event.xlsx" index="id"/>

    <!-- Separate flat table joined by eventId, rather than nesting choices
         as a list-in-one-row inside EventRow. Luban supports nested lists
         via a multi-row-per-record Excel layout, but it needs extra
         sub-header rows and is easy to get subtly wrong when hand-authoring
         (and hard to verify without a live Luban run). Two flat, bulk-editable
         tables joined by a plain string key is simpler and safer, and still
         solves the original goal (no per-item Editor asset clicking). -->
    <bean name="EventChoiceRow">
        <var name="eventId" type="string"/>
        <var name="choiceId" type="string"/>
        <var name="label" type="string"/>
    </bean>
    <table name="TbEventChoice" value="EventChoiceRow" input="event_choice.xlsx" mode="list"/>
</module>
